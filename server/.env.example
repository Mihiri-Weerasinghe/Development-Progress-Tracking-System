# Server Port
PORT=5000

# MongoDB Cloud Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dpts_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Email Service (Gmail SMTP or custom SMTP)
# For Gmail: Use your Gmail address and 16-character Google App Password (not your normal Google password)
# Generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_FROM="Zonal Education Office Katugastota" <your_email@gmail.com>

# Optional Custom SMTP (leave empty to use Gmail service)
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=587
# EMAIL_SECURE=false
